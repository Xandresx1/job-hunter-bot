[Unit]
Description=Job Hunter Bot (ofertas junior/trainee -> ntfy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# Ajusta la ruta si instalaste el bot en otro directorio
WorkingDirectory=/opt/job-hunter-bot
EnvironmentFile=/opt/job-hunter-bot/.env
ExecStart=/opt/job-hunter-bot/venv/bin/python /opt/job-hunter-bot/main.py
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=job_hunter

[Install]
WantedBy=multi-user.target
